// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Entreprise {
  id          Int      @id @default(autoincrement())
  nom         String
  identifiant String   @unique
  adresse     String
  pays        String
  region      String
  ville       String
  logo        String?
  is_active   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  budgetsAnnuels BudgetAnnuel[]
  departements   Departement[]

  @@map("entreprises")
}

model BudgetAnnuel {
  id                     Int      @id @default(autoincrement())
  reference              String   @unique
  identifiant_entreprise String
  annee                  Int
  date_debut             DateTime
  date_fin               DateTime
  budget                 Decimal
  montant_restant        Decimal
  est_active             Boolean  @default(false)
  est_cloture            Boolean  @default(false)
  createdAt              DateTime @default(now())

  entreprise       Entreprise        @relation(fields: [identifiant_entreprise], references: [identifiant])
  budgetDepartements BudgetDepartement[]
  budgetPersonnels   BudgetPersonnel[]

  @@map("budget_annuel")
}

model Departement {
  id           Int        @id @default(autoincrement())
  nom          String
  entrepriseId Int

  entreprise Entreprise @relation(fields: [entrepriseId], references: [id])
  users      User[]
  budgetDepartements BudgetDepartement[]

  @@map("departements")
}

enum Role {
  MANAGER
  EMPLOYE
  CONSULTANT
}

model User {
  id           Int        @id @default(autoincrement())
  entrepriseId Int
  prenom       String
  nom          String
  email        String     @unique
  matricule    String   @unique
  departementId Int
  poste        String
  telephone    String
  mot_de_passe String
  role         Role       @default(EMPLOYE)
  is_block     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  entreprise      Entreprise       @relation(fields: [entrepriseId], references: [id])
  departement     Departement      @relation(fields: [departementId], references: [id])
  budgetPersonnels BudgetPersonnel[]
  politique       Politique?

  @@map("users")
}

model BudgetDepartement {
  id              Int      @id @default(autoincrement())
  reference       String
  departementId   Int
  montant_alloue  Decimal
  montant_utilise Decimal  @default(0)
  montant_restant Decimal
  bloquer         Boolean  @default(false)
  createdAt       DateTime @default(now())

  budgetAnnuel BudgetAnnuel @relation(fields: [reference], references: [reference])
  departement  Departement  @relation(fields: [departementId], references: [id])

  @@map("budget_departements")
}

model BudgetPersonnel {
  id              Int      @id @default(autoincrement())
  reference       String
  matricule       String
  montant_alloue  Decimal
  montant_utilise Decimal  @default(0)
  montant_restant Decimal
  bloquer         Boolean  @default(false)
  createdAt       DateTime @default(now())

  budgetAnnuel BudgetAnnuel @relation(fields: [reference], references: [reference])
  user         User         @relation(fields: [matricule], references: [matricule])

  @@map("budget_personnels")
}

model AuditBudget {
  id                 Int      @id @default(autoincrement())
  reference          String
  entrepriseId       Int
  action             String
  type_source        String?
  type_destination   String?
  montant            Decimal?
  montant_avant      Decimal?
  montant_apres      Decimal?
  description        String?
  effectue_par       String
  effectue_par_id    Int?
  role_effectue_par  String?  // SUPERADMIN, MANAGER, etc.
  target_id          Int?     // id département cible si applicable
  target_matricule   String?  // matricule personnel cible si applicable
  createdAt          DateTime @default(now())

  @@map("audit_budgets")
}

model Politique {
  id        Int      @id @default(autoincrement())
  matricule String   @unique
  y         Boolean  @default(false)  // économique
  w         Boolean  @default(false)  // Économie Premium
  j         Boolean  @default(false)  // Affaires / Business
  f         Boolean  @default(false)  // Première classe
  hotel     Int      @default(0)      // étoiles max autorisées
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [matricule], references: [matricule])

  @@map("politiques")
}
