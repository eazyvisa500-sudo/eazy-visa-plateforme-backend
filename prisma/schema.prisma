// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Entreprise {
  id          Int      @id @default(autoincrement())
  nom         String
  identifiant String   @unique
  adresse     String
  pays        String
  region      String
  ville       String
  logo        String?
  is_active   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  budgetsAnnuels BudgetAnnuel[]
  departements   Departement[]

  @@map("entreprises")
}

model BudgetAnnuel {
  id                     Int      @id @default(autoincrement())
  reference              String   @unique
  identifiant_entreprise String
  annee                  Int
  date_debut             DateTime
  date_fin               DateTime
  est_active             Boolean  @default(false)
  est_cloture            Boolean  @default(false)
  createdAt              DateTime @default(now())

  entreprise Entreprise @relation(fields: [identifiant_entreprise], references: [identifiant])

  @@map("budget_annuel")
}

model Departement {
  id           Int        @id @default(autoincrement())
  nom          String
  entrepriseId Int

  entreprise Entreprise @relation(fields: [entrepriseId], references: [id])
  users      User[]

  @@map("departements")
}

enum Role {
  MANAGER
  EMPLOYE
  CONSULTANT
}

model User {
  id           Int        @id @default(autoincrement())
  entrepriseId Int
  prenom       String
  nom          String
  email        String     @unique
  matricule    String   @unique
  departementId Int
  poste        String
  telephone    String
  mot_de_passe String
  role         Role       @default(EMPLOYE)
  is_block     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  entreprise  Entreprise  @relation(fields: [entrepriseId], references: [id])
  departement Departement @relation(fields: [departementId], references: [id])

  @@map("users")
}
